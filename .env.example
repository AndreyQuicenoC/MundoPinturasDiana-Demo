# --- Vercel / Netlify (obligatorio) ---
DATABASE_URI=postgresql://user:pass@host/db?sslmode=require
PAYLOAD_SECRET=genera-un-secreto-largo-minimo-32-chars
PAYLOAD_DB_PUSH=true

# URL pública (Vercel/Netlify suelen inyectar VERCEL_URL o URL; puedes fijarla)
NEXT_PUBLIC_SITE_URL=https://tu-sitio.netlify.app

# Sembrar demo en el primer deploy (opcional; quitar después)
SEED_DEMO=true

